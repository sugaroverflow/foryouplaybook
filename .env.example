# Backend
PORT=3000
DATABASE_URL=./data/foryouplaybook.sqlite
FRONTEND_URL=http://localhost:5173

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# xAI / Grok
XAI_API_KEY=
XAI_MODEL=grok-3-latest

# 32-byte hex key for encrypting X OAuth tokens.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# X API cost governor: posts read per scan, and scans allowed per calendar
# month (size to your X tier's monthly post-read quota / MAX_POSTS)
MAX_POSTS=100
MONTHLY_SCAN_BUDGET=100

# Cutoff for the current For You regime
CURRENT_REGIME_START=2026-07-31T00:00:00.000Z
